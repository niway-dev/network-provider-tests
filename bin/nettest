#!/usr/bin/env bash
# nettest - diagnose home internet / ISP problems on macOS.
#
#   nettest              run every check, print a diagnosis, record the run
#   nettest <name>       run one check (e.g. "dns", "06-dns" or "06"), then diagnose what is known
#   nettest history      show recent recorded runs as a table
#   nettest watch [min]  run the full suite every <min> minutes until Ctrl-C
#   nettest --list       list the available checks
#
# Every run appends one JSON line to $NETTEST_DATA_DIR/runs.jsonl
# (default ~/Library/Logs/network-provider-tests). See docs/run-record.md.
#
# Exit status: 0 if no check reported FAIL, 1 otherwise, 2 on usage errors.
set -u

# Resolve symlinks so the script works when linked into ~/.local/bin.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"

unset NT_RESULTS
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# shellcheck source=../lib/diagnose.sh
. "$ROOT/lib/diagnose.sh"
# shellcheck source=../lib/record.sh
. "$ROOT/lib/record.sh"
# shellcheck source=../lib/history.sh
. "$ROOT/lib/history.sh"

usage() {
  cat <<USAGE
Usage: nettest [--list | --version | --help | <check> | history [N] [--since D] | watch [minutes]]

  (no argument)        run all checks, print a diagnosis, record the run
  <check>              run a single check by name ("dns"), file stem ("06-dns") or number ("06")
  history [N]          table of the last N recorded runs (default 20); --since 2h / 1d filters
  watch [minutes]      run everything every N minutes (default 5), one summary line per run, until Ctrl-C
  --list               list the checks
  --version            print the version
  --help               show this help

Runs are recorded in \${NETTEST_DATA_DIR:-~/Library/Logs/network-provider-tests}/runs.jsonl.
Set NO_COLOR=1 to disable colors. Use nettest-log to also keep the printed output in a daily log.
USAGE
}

check_files() { ls "$ROOT"/checks/[0-9][0-9]-*.sh 2>/dev/null; }
check_stem() { basename "$1" .sh; }                  # 06-dns
check_name() { check_stem "$1" | sed 's/^[0-9][0-9]-//'; } # dns
check_desc() { sed -n 's/^# DESC: //p' "$1" | head -n 1; }

list_checks() {
  local f
  for f in $(check_files); do
    printf '%-22s %s\n' "$(check_stem "$f")" "$(check_desc "$f")"
  done
}

# --- one run: checks, summary, diagnosis, record -------------------------------
export NT_RESULTS
SUITE_RC=0
SUITE_DURATION_MS=0

# run_suite <mode: full|single> <check file...>
run_suite() {
  local mode="$1" f name st col t0 t1
  shift
  local files="$*"
  : > "$NT_RESULTS"
  NT_DIAG_FOUND=0
  t0=$(nt_now_ms)

  printf '%snettest%s  %s  on %s\n' "$C_BOLD" "$C_RESET" "$(date '+%Y-%m-%d %H:%M:%S %z')" "$(scutil --get ComputerName 2>/dev/null || hostname)"

  local overall_fail=0 rc ran=""
  for f in $files; do
    bash "$f"
    rc=$?
    ran="$ran $(check_name "$f")"
    if [ "$rc" -eq 1 ]; then
      overall_fail=1
    elif [ "$rc" -ne 0 ]; then
      overall_fail=1
      nt_fail "check $(check_stem "$f") crashed with exit status $rc"
    fi
  done
  ran="${ran# }"

  printf '\n%s== Summary ==%s\n' "$C_BOLD" "$C_RESET"
  for f in $files; do
    name=$(check_name "$f")
    st=$(nt_get "STATUS_$(printf '%s' "$name" | tr '-' '_')")
    case "$st" in
      PASS) col=$C_GREEN ;; WARN) col=$C_YELLOW ;; FAIL) col=$C_RED ;; *) col=$C_GRAY; st=${st:-N/A} ;;
    esac
    printf '  %s%-4s%s  %s\n' "$col" "$st" "$C_RESET" "$(check_stem "$f")"
  done

  printf '\n%s== Diagnosis ==%s\n' "$C_BOLD" "$C_RESET"
  diagnose "$ran"

  t1=$(nt_now_ms)
  SUITE_DURATION_MS=$((t1 - t0))
  # shellcheck disable=SC2086 # $ran is a list of check names
  nt_append_record "$(nt_build_record "$mode" "$SUITE_DURATION_MS" "$overall_fail" $ran)"
  SUITE_RC=$overall_fail
}

# --- watch ----------------------------------------------------------------------
# worst_status: FAIL / WARN / PASS across the checks of the run that just finished.
worst_status() {
  if grep -q '^STATUS_.*=FAIL$' "$NT_RESULTS"; then echo FAIL
  elif grep -q '^STATUS_.*=WARN$' "$NT_RESULTS"; then echo WARN
  else echo PASS; fi
}

watch_loop() {
  local minutes="${1:-5}" secs sleep_pid="" n=0 res col codes
  case "$minutes" in
    ''|*[!0-9.]*|.*|*.*.*) echo "nettest watch: minutes must be a positive number, got '$minutes'" >&2; return 2 ;;
  esac
  secs=$(awk -v m="$minutes" 'BEGIN { s = int(m * 60); if (s < 1) s = 1; print s }')
  if ! awk -v m="$minutes" 'BEGIN { exit !(m > 0) }'; then
    echo "nettest watch: minutes must be greater than 0" >&2; return 2
  fi

  trap 'printf "\n%s\n" "nettest watch: stopped after $n run(s). Runs are in $(nt_data_dir)/runs.jsonl"; [ -n "$sleep_pid" ] && kill "$sleep_pid" 2>/dev/null; exit 0' INT TERM
  printf '%snettest watch%s: a full run every %s min, recorded in %s/runs.jsonl. Ctrl-C to stop.\n' \
    "$C_BOLD" "$C_RESET" "$minutes" "$(nt_data_dir)"
  while :; do
    local files; files="$(check_files)"
    # shellcheck disable=SC2086 # $files is a newline-separated list of paths without spaces
    run_suite full $files >/dev/null 2>&1
    n=$((n + 1))
    res=$(worst_status)
    case "$res" in FAIL) col=$C_RED ;; WARN) col=$C_YELLOW ;; *) col=$C_GREEN ;; esac
    codes=$(nt_get_all DIAG | cut -d'|' -f1 | paste -sd, -)
    printf '%s  %s%-4s%s  %s  (%s s)\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$col" "$res" "$C_RESET" \
      "${codes:--}" "$((SUITE_DURATION_MS / 1000))"
    sleep "$secs" &
    sleep_pid=$!
    wait "$sleep_pid" 2>/dev/null
    sleep_pid=""
  done
}

# --- argument parsing -----------------------------------------------------------
selected=""
case "${1:-}" in
  "") ;;
  --list|-l) list_checks; exit 0 ;;
  --help|-h) usage; exit 0 ;;
  --version|-V) echo "nettest $NT_VERSION"; exit 0 ;;
  history) shift; nt_history "$@"; exit $? ;;
  watch)
    shift
    watch_loop "$@"
    exit $?
    ;;
  -*) echo "nettest: unknown option '$1'" >&2; usage >&2; exit 2 ;;
  *)
    for f in $(check_files); do
      if [ "$1" = "$(check_name "$f")" ] || [ "$1" = "$(check_stem "$f")" ] || [ "$1" = "${f##*/checks/}" ] || [ "$1" = "$(check_stem "$f" | cut -c1-2)" ]; then
        selected="$f"
      fi
    done
    if [ -z "$selected" ]; then
      echo "nettest: no such check '$1'. Available checks:" >&2
      list_checks >&2
      exit 2
    fi
    ;;
esac

if [ -n "$selected" ]; then
  run_suite single "$selected"
else
  # shellcheck disable=SC2046 # check paths contain no spaces
  run_suite full $(check_files)
fi
exit "$SUITE_RC"
