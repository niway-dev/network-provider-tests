#!/usr/bin/env bash
# nettest - diagnose home internet / ISP problems on macOS.
#
#   nettest            run every check, then print a diagnosis
#   nettest <name>     run one check (e.g. "dns", "06-dns" or "06"), then diagnose what is known
#   nettest --list     list the available checks
#
# Exit status: 0 if no check reported FAIL, 1 otherwise, 2 on usage errors.
set -u

# Resolve symlinks so the script works when linked into ~/.local/bin.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd "$(dirname "$src")/.." && pwd)"

unset NT_RESULTS
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"

usage() {
  cat <<USAGE
Usage: nettest [--list | --help | <check>]

  (no argument)   run all checks and print a diagnosis
  <check>         run a single check by name ("dns"), file stem ("06-dns") or number ("06")
  --list          list the checks
  --help          show this help

Set NO_COLOR=1 to disable colors. Use nettest-log to keep a timestamped log.
USAGE
}

check_files() { ls "$ROOT"/checks/[0-9][0-9]-*.sh 2>/dev/null; }
check_stem() { basename "$1" .sh; }                  # 06-dns
check_name() { check_stem "$1" | sed 's/^[0-9][0-9]-//'; } # dns
check_desc() { sed -n 's/^# DESC: //p' "$1" | head -n 1; }

list_checks() {
  local f
  for f in $(check_files); do
    printf '%-22s %s\n' "$(check_stem "$f")" "$(check_desc "$f")"
  done
}

# --- argument parsing ---------------------------------------------------------
selected=""
case "${1:-}" in
  "") ;;
  --list|-l) list_checks; exit 0 ;;
  --help|-h) usage; exit 0 ;;
  -*) echo "nettest: unknown option '$1'" >&2; usage >&2; exit 2 ;;
  *)
    for f in $(check_files); do
      if [ "$1" = "$(check_name "$f")" ] || [ "$1" = "$(check_stem "$f")" ] || [ "$1" = "${f##*/checks/}" ] || [ "$1" = "$(check_stem "$f" | cut -c1-2)" ]; then
        selected="$f"
      fi
    done
    if [ -z "$selected" ]; then
      echo "nettest: no such check '$1'. Available checks:" >&2
      list_checks >&2
      exit 2
    fi
    ;;
esac

# --- run checks ---------------------------------------------------------------
printf '%snettest%s  %s  on %s\n' "$C_BOLD" "$C_RESET" "$(date '+%Y-%m-%d %H:%M:%S %z')" "$(scutil --get ComputerName 2>/dev/null || hostname)"

export NT_RESULTS
if [ -n "$selected" ]; then files="$selected"; else files="$(check_files)"; fi

overall_fail=0
ran=""
for f in $files; do
  bash "$f"
  rc=$?
  ran="$ran $(check_name "$f")"
  if [ "$rc" -eq 1 ]; then
    overall_fail=1
  elif [ "$rc" -ne 0 ]; then
    overall_fail=1
    nt_fail "check $(check_stem "$f") crashed with exit status $rc"
  fi
done
ran="${ran# }"

# --- summary ------------------------------------------------------------------
printf '\n%s== Summary ==%s\n' "$C_BOLD" "$C_RESET"
for f in $files; do
  name=$(check_name "$f")
  st=$(nt_get "STATUS_$(printf '%s' "$name" | tr '-' '_')")
  case "$st" in
    PASS) col=$C_GREEN ;; WARN) col=$C_YELLOW ;; FAIL) col=$C_RED ;; *) col=$C_GRAY; st=${st:-N/A} ;;
  esac
  printf '  %s%-4s%s  %s\n' "$col" "$st" "$C_RESET" "$(check_stem "$f")"
done

# --- diagnosis ----------------------------------------------------------------
found=0
say() { # first line is the finding, remaining arguments are indented advice
  found=$((found + 1))
  printf '  %s*%s %s%s%s\n' "$C_BOLD" "$C_RESET" "$C_BOLD" "$1" "$C_RESET"
  shift
  local l
  for l in "$@"; do printf '      %s\n' "$l"; done
}

num() { local v="${1:-}"; case "$v" in ''|*[!0-9]*) echo "" ;; *) echo "$v" ;; esac; }

diagnose() {
  local gw_ok v4_ok v4_tot v6_global v6_ok v6_tot icmp_ok icmp_tot
  local reached last_hop last_ip sys_status prim_bad via_vpn prim_if
  gw_ok=$(nt_get GW_OK)
  v4_ok=$(num "$(nt_get V4_HTTPS_OK)");  v4_tot=$(num "$(nt_get V4_HTTPS_TOTAL)")
  v6_global=$(nt_get V6_GLOBAL)
  v6_ok=$(num "$(nt_get V6_HTTPS_OK)");  v6_tot=$(num "$(nt_get V6_HTTPS_TOTAL)")
  icmp_ok=$(num "$(nt_get V4_ICMP_OK)"); icmp_tot=$(num "$(nt_get V4_ICMP_TOTAL)")
  reached=$(nt_get TRACE_REACHED); last_hop=$(nt_get TRACE_LAST_HOP); last_ip=$(nt_get TRACE_LAST_IP)
  sys_status=$(nt_get DNS_SYS_STATUS); prim_bad=$(nt_get DNS_PRIMARY_TIMEOUTS); prim_bad="${prim_bad// /, }"
  via_vpn=$(nt_get DNS_PRIMARY_VIA_VPN); prim_if=$(nt_get DNS_PRIMARY_IF)

  local v4_known=0 v4_fail=0 v6_known=0 v6_works=0 local_down=0
  if [ -n "$v4_tot" ] && [ "$v4_tot" -gt 0 ]; then
    v4_known=1
    [ $((v4_ok * 2)) -lt "$v4_tot" ] && v4_fail=1
  fi
  if [ -n "$v6_tot" ] && [ "$v6_tot" -gt 0 ]; then
    v6_known=1
    [ $((v6_ok * 2)) -ge "$v6_tot" ] && v6_works=1
  fi

  # 1. Gateway.
  if [ "$gw_ok" = 0 ]; then
    if [ "$v4_known" -eq 1 ] && [ "$v4_fail" -eq 0 ]; then
      say "The router does not answer ping, but internet traffic works." \
        "Harmless: many routers ignore ICMP. Nothing to fix."
    else
      local_down=1
      say "Local network problem: this Mac cannot reach its own router." \
        "The ISP is probably not the cause. Restart the router, check the cable or Wi-Fi signal," \
        "and make sure this Mac is connected to the right network."
    fi
  fi

  # 2. IPv4 / IPv6 / ISP.
  if [ "$local_down" -eq 0 ] && [ "$v4_fail" -eq 1 ]; then
    local hop_txt="IPv4 stops somewhere past your router"
    if [ "$reached" = 0 ] && [ -n "$last_hop" ] && [ "$last_hop" != 0 ]; then
      hop_txt="IPv4 stops after hop $last_hop ($last_ip)"
    fi
    if [ "$v6_known" -eq 1 ] && [ "$v6_works" -eq 1 ]; then
      say "ISP IPv4 outage (often their CGNAT): sites with IPv6 load, IPv4-only sites don't." \
        "Restart the router/ONT. If it persists, report to the ISP that $hop_txt, IPv6 works."
    elif [ "$v6_known" -eq 1 ]; then
      say "Both IPv4 and IPv6 fail past your router: the ISP connection is down." \
        "Restart the router/ONT. If it persists, report to the ISP that $hop_txt and IPv6 fails too."
    elif [ "$v6_global" = 0 ]; then
      say "IPv4 fails past your router and this network has no IPv6 to compare." \
        "Most likely an ISP outage. Restart the router/ONT; if it persists, report that $hop_txt."
    else
      say "IPv4 fails past your router." \
        "Run the full nettest (without arguments) to compare with IPv6. Restart the router/ONT; if it persists, report that $hop_txt."
    fi
  fi

  # 3. DNS.
  local any_dns_ok=0
  if nt_get_all DNS_SERVER | grep -q '|OK|'; then any_dns_ok=1; fi
  if { [ "$sys_status" = WARN ] || [ "$sys_status" = FAIL ]; } && [ "$any_dns_ok" -eq 1 ]; then
    if [ -n "$prim_bad" ]; then
      if [ "$via_vpn" = 1 ]; then
        say "The primary DNS resolver is timing out: $prim_bad (a VPN resolver, reached through $prim_if)." \
          "Every lookup waits for that timeout before the OS falls back to another server, so sites feel slow." \
          "Disconnect the VPN or ask its administrator to fix its upstream DNS."
      else
        say "The primary DNS resolver is timing out: $prim_bad." \
          "Every lookup waits for that timeout before the OS falls back. Other servers answer quickly;" \
          "remove the dead server or switch DNS in Network settings (router address or a public resolver)."
      fi
    else
      say "System DNS is slow although the configured servers answered the direct tests." \
        "It may be intermittent. Re-run, and look at the 06-dns output to see which lookups were slow."
    fi
  fi

  # 4. ICMP loss with working HTTPS.
  if [ "$local_down" -eq 0 ] && [ "$v4_known" -eq 1 ] && [ "$v4_fail" -eq 0 ] \
    && [ -n "$icmp_tot" ] && [ "$icmp_ok" -lt "$icmp_tot" ]; then
    say "Some pings to public servers got no reply, but HTTPS works." \
      "Harmless: the ISP deprioritizes or drops ping. This is not an outage."
  fi

  # 5. Nothing matched.
  if [ "$found" -eq 0 ]; then
    if grep -Eq '^STATUS_.*=(FAIL|WARN)$' "$NT_RESULTS"; then
      say "No known pattern matched, but some checks reported WARN or FAIL." \
        "Read the WARN/FAIL lines above; the hint under each one explains what it means."
    else
      say "No problem detected right now." \
        "Checks run: $ran. If the problem comes and goes, run nettest-log during an incident."
    fi
  fi
}

printf '\n%s== Diagnosis ==%s\n' "$C_BOLD" "$C_RESET"
diagnose

exit "$overall_fail"
